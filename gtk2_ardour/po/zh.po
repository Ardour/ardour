#: add_route_dialog.cc:181 recorder_ui.cc:1251
msgid "Flexible-I/O"
msgstr "弹性-输入/输出"

#: add_route_dialog.cc:182 recorder_ui.cc:1252
msgid "Strict-I/O"
msgstr "精确-输入/输出"

#: add_route_dialog.cc:216
msgid "Template/Type"
msgstr "模板/类型"

