msgstr "所有可用的处理器"

#: rc_option_editor.cc:5114 rc_option_editor.cc:5245
msgid "%1 processor"
msgid_plural "%1 processors"
msgstr[0] "%1 处理器"

#: rc_option_editor.cc:5117 rc_option_editor.cc:5248
msgid "This setting will only take effect when %1 is restarted."
msgstr "该设置将仅仅在 %1 重新启动时起作用。"

#: rc_option_editor.cc:5127
msgid "Power Management, CPU DMA latency"
msgstr "电源管理, CPU DMA 延迟"

#: rc_option_editor.cc:5158
msgid "Lowest (prevent CPU sleep states)"
msgstr "最低（防止 CPU 进入休眠状态）"

#: rc_option_editor.cc:5161
msgid "%1 usec"
msgstr "%1 微秒"

#: rc_option_editor.cc:5164
msgid ""
"This setting sets the maximum tolerable CPU DMA latency. This prevents the "
"CPU from entering power-save states which can be beneficial for reliable low "
"latency."
msgstr ""
"此设置决定可容忍的最大 CPU DMA 延迟。它可防止 CPU 进入节能状态，从而有助于可靠地实现低延迟。"

#: rc_option_editor.cc:5167
msgid "This setting requires write access to `/dev/cpu_dma_latency'."
msgstr "此设置需要对 `/dev/cpu_dma_latency' 具有写入权限。"

#: rc_option_editor.cc:5176
msgid "CPU/FPU Denormals"
msgstr "CPU/FPU 非规格化数"

#: rc_option_editor.cc:5181
