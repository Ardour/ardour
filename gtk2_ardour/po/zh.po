#: opts.cc:72
msgid ""
"%1 is a digital audio workstation, used for multitrack recording, nonlinear, "
"nondestructive editing and much more."
msgstr ""
"%1 是一款数字音频工作站，用于多轨录音、非线性非破坏性编辑以及更多任务。"

#: opts.cc:74
msgid "Options:\n"
msgstr "选项：\n"

#: opts.cc:75
msgid ""
"  -a, --no-announcements      Do not contact website for announcements\n"
msgstr "  -a, --no-announcements      不获取网站公告\n"

#: opts.cc:76
msgid "  -A, --actions               Print all possible menu action names\n"
msgstr "  -A, --actions               打印所有可用菜单动作名称\n"

#: opts.cc:77
msgid "  -b, --bindings              Display all current key bindings\n"
msgstr "  -b, --bindings              显示所有当前按键绑定\n"

#: opts.cc:78
msgid ""
"  -B, --bypass-plugins        Bypass all plugins in an existing session\n"
msgstr ""
"  -B, --bypass-plugins        略过在已存在会话中的所有插件\n"

#: opts.cc:79
msgid ""
"  -c, --name <name>           Use a specific backend client name, default is "
"ardour\n"
msgstr ""
"  -c, --name <name>            使用指定的后端客户端名称，默认为 ardour\n"

#: opts.cc:80
msgid "  -d, --disable-plugins       Disable all plugins (safe mode)\n"
msgstr "  -d, --disable-plugins       禁用所有插件（安全模式）\n"

#: opts.cc:82
msgid ""
"  -D, --debug <options>       Set debug flags. Use \"-D list\" to see "
"available options\n"
msgstr ""
"  -D, --debug <options>        设置调试标志。使用 \"-D list\" 查看可用选项\n"

#: opts.cc:84
msgid "  -h, --help                  Print this message\n"
msgstr "  -h, --help                  打印本信息\n"

#: opts.cc:85
msgid "  -k, --keybindings <file>    Path to the key bindings file to load\n"
msgstr "  -k, --keybindings <file>    要载入的按键绑定文件的路径\n"

#: opts.cc:86
msgid "  -m, --menus file            Use \"file\" to define menus\n"
msgstr "  -m, --menus file            使用“file”（文件）来定义菜单\n"

#: opts.cc:87
msgid "  -n, --no-splash             Do not show splash screen\n"
msgstr "  -n, --no-splash             不显示闪屏\n"

#: opts.cc:88
msgid ""
"  -N, --new <session-name>    Create a new session from the command line\n"
msgstr ""
"  -N, --new <session-name>    从命令行创建新会话\n"

#: opts.cc:89
msgid "  -O, --no-hw-optimizations   Disable h/w specific optimizations\n"
msgstr "  -O, --no-hw-optimizations   禁用 h/w 特殊的优化\n"

#: opts.cc:90
msgid "  -P, --no-connect-ports      Do not connect any ports at startup\n"
msgstr "  -P, --no-connect-ports     在启动时不连接任何端口\n"

#: opts.cc:91
msgid "  -s, --no-strobe             Avoid \"strobe-like\" effects in GUI\n"
msgstr ""
"  -s, --no-strobe             避免 GUI 中的“频闪”效果\n"

#: opts.cc:92
msgid "  -S, --sync                  Draw the GUI synchronously\n"
msgstr "  -S, --sync                  同步绘制 GUI（图形用户界面）\n"

#: opts.cc:93
msgid "  -T, --template <name>       Use given template for new session\n"
msgstr "  -T, --template <name>       为新会话使用指定的模板\n"

