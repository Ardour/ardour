msgstr "显示“已吸附的光标”"

#: rc_option_editor.cc:3604
msgid "Snap rubberband selection to grid"
msgstr "将橡皮筋已选择部分吸附到网格"

#: rc_option_editor.cc:3612
msgid "Grid switches to alternate selection for Internal Edit tools"
msgstr "网格切换为内部编辑工具的交替选区"

#: rc_option_editor.cc:3620
msgid "Grid mode selection may change ruler visibility"
msgstr "网格模式选择可能改变标尺可见性"

#: rc_option_editor.cc:3629
msgid "Rulers automatically change to follow the Grid mode selection"
msgstr "标尺会自动随网格模式选择而变化"

#: rc_option_editor.cc:3634
msgid "Snap Target Mode:"
msgstr "吸附目标模式："

#: rc_option_editor.cc:3638
