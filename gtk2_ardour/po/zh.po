msgstr "吸附临界值（像素）"

#: rc_option_editor.cc:3569
msgid "Approximate Grid/Ruler granularity (pixels)"
msgstr "近似网格/标尺粒度（像素）"

#: rc_option_editor.cc:3576
msgid "Region Editing"
msgstr "区域编辑"

#: rc_option_editor.cc:3579
