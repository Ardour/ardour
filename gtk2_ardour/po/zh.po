msgstr "吸附 Targets:"

#: rc_option_editor.cc:3668
msgid "Region Sync Points"
msgstr "区域同步点"

#: rc_option_editor.cc:3676
msgid "Region Starts"
msgstr "区域起点"

#: rc_option_editor.cc:3684
msgid "Region Ends"
msgstr "区域终点"

#: rc_option_editor.cc:3689 rc_option_editor.cc:3690 rc_option_editor.cc:3691
msgid "Editor/Modifiers"
msgstr "编辑器/修改器"

#: rc_option_editor.cc:3689
msgid "Keyboard Modifiers"
msgstr "键盘组合键"

#: rc_option_editor.cc:3701
msgid "Initial program change"
msgstr "初始程序改变"

#: rc_option_editor.cc:3707
msgid "Editing"
msgstr "编辑"

#: rc_option_editor.cc:3712
msgid "Show velocity horizontally inside notes"
msgstr "在音符内水平显示力度"

#: rc_option_editor.cc:3720
msgid "Use cross-cursor when editing MIDI"
msgstr "编辑 MIDI 时使用十字光标"

#: rc_option_editor.cc:3727
msgid "Default MIDI note colors"
msgstr "默认 MIDI 音符颜色"

#: rc_option_editor.cc:3741
msgid "When drawing new notes, select only the last drawn note"
msgstr "绘制新音符时，仅选择最后绘制的音符"

#: rc_option_editor.cc:3749
msgid "Scroll wheel use when editing MIDI adjusts selected note velocity"
msgstr "编辑 MIDI 时使用滚轮可调整所选音符的力度"

#: rc_option_editor.cc:3754
msgid "MIDI Chase"
msgstr "MIDI 追踪"

#: rc_option_editor.cc:3758
msgid "When locating, track sustained MIDI notes and play them when rolling"
msgstr "定位时跟踪延续的 MIDI 音符，并在滚动播放时播放它们"

#: rc_option_editor.cc:3763
msgid "Output Port Panic"
msgstr "输出端口紧急停止"

#: rc_option_editor.cc:3767
msgid ""
"MIDI output ports should send panic message at end of a timeline (transport) "
"loop"
msgstr ""
"MIDI 输出端口应在时间线（传输）循环结束时发送紧急停止消息"

#: rc_option_editor.cc:3777
msgid "Sound MIDI notes as they are selected in the editor"
msgstr "在编辑器中选择 MIDI 音符时播放其声音"

#: rc_option_editor.cc:3786
msgid "Virtual Keyboard Layout"
msgstr "虚拟键盘布局"

#: rc_option_editor.cc:3791
msgid "Mouse-only (no keyboard)"
msgstr "仅用鼠标（无键盘）"

#: rc_option_editor.cc:3792
msgid "QWERTY"
msgstr "QWERTY（标准的传统键盘）"

#: rc_option_editor.cc:3793
msgid "QWERTZ"
msgstr "QWERTZ（东欧及德语键盘）"

#: rc_option_editor.cc:3794
msgid "AZERTY"
msgstr "AZERTY（法国键盘）"

#: rc_option_editor.cc:3795
msgid "DVORAK"
msgstr "DVORAK（手平衡键盘）"

#: rc_option_editor.cc:3796
msgid "QWERTY Single"
msgstr "QWERTY（标准的传统键盘）独用"

#: rc_option_editor.cc:3797
msgid "QWERTZ Single"
msgstr "QWERTZ（东欧及德语键盘）独用"

#: rc_option_editor.cc:3801
msgid "Default Visible Note Range"
msgstr "默认可见音符范围"

#: rc_option_editor.cc:3803
msgid "legal characters for MIDI note names|ABCDEFG#1234567890"
msgstr "ABCDEFG#1234567890"

#: rc_option_editor.cc:3805
msgid "Default lower visible MIDI note"
msgstr "默认可见 MIDI 音符下限"

#: rc_option_editor.cc:3810
msgid "Default upper visible MIDI note"
msgstr "默认可见 MIDI 音符上限"

#: rc_option_editor.cc:3815
msgid "Maximum note height"
msgstr "最大音符高度"

#: rc_option_editor.cc:3824
msgid "MIDI Port Options"
msgstr "MIDI 端口选项"

#: rc_option_editor.cc:3829
msgid "MIDI input follows MIDI track selection"
msgstr "MIDI 输入跟随 MIDI 音轨选择"

#: rc_option_editor.cc:3834 rc_option_editor.cc:3835
msgid "MIDI/MIDI Port Config"
msgstr "MIDI/MIDI端口配置"

#: rc_option_editor.cc:3845
msgid "Prompt for new marker names"
msgstr "提示新的标记名称"

#: rc_option_editor.cc:3850
msgid ""
"<b>When enabled</b>, popup a dialog when a new marker is created to allow "
"its name to be set as it is created.\n"
"\n"
"You can always rename markers by right-clicking on them."
msgstr ""
"<b>启用时</b>，创建新标记时会弹出对话框，允许在创建时为其设置名称。\n"
"\n"
"您随时可以通过右键点击标记来对其重命名。"

#: rc_option_editor.cc:3855
msgid "Stop at the end of the session"
msgstr "在会话终点停止"

#: rc_option_editor.cc:3860
msgid ""
"<b>When enabled</b> if %1 is <b>not recording</b>, and <b>all trigger-slots "
"are unused</b> the transport is stopped when it reaches the current session "
"end marker\n"
"\n"
"<b>When disabled</b> %1 will continue to roll past the session end marker at "
"all times"
msgstr ""
"<b>启用时</b>，如果 %1 <b>未在录制</b>，且<b>所有触发器槽位均未使用</b>，则传"
"输（transport）在到达当前会话结束标记时停止。\n"
"\n"
"<b>禁用时</b>，%1 将在任何时候都继续滚动越过会话结束标记。"

#: rc_option_editor.cc:3869
msgid "Keep record-enable engaged on stop"
msgstr "停止时，保持录制启用"

#: rc_option_editor.cc:3875
msgid ""
"<b>When enabled</b> master record will remain engaged when the transport "
"transitions to stop.\n"
"<b>When disabled</b> master record will be disabled when the transport "
"transitions to stop."
msgstr ""
"<b>启用时</b>，当传输（transport）停止时，总录音状态将保持启用。\n"
"<b>禁用时</b>，当传输（transport）停止时，总录音状态将被禁用。"

#: rc_option_editor.cc:3879
msgid "Reset default speed on stop"
msgstr "在停止时，重置默认速度"

#: rc_option_editor.cc:3885
msgid ""
"<b>When enabled</b>, stopping the transport will reset the default speed to "
"normal.\n"
"<b>When disabled</b> any current default speed will remain in effect across "
"transport stops."
msgstr ""
" <b> 启用时 </b> , stopping  transport 将 reset  default 速度 到 normal.\n"
" <b> 禁用时 </b>  any 当前 default 速度 将 remain 在 effect across transport stops."

#: rc_option_editor.cc:3889
msgid "Disable per-track record disarm while rolling"
msgstr "当滚动时禁用预先音轨录制解除预备"

#: rc_option_editor.cc:3893
msgid ""
"<b>When enabled</b> this will prevent you from accidentally stopping "
"specific tracks recording during a take."
msgstr ""
"<b>启用时</b> 这将防止您意外停止获取一个特定的音轨录制。"

#: rc_option_editor.cc:3898
msgid "12dB gain reduction during fast-forward and fast-rewind"
msgstr "快进和倒带时有 12dB 的增益减少"

#: rc_option_editor.cc:3903
msgid ""
"<b>When enabled</b> this will reduce the unpleasant increase in perceived "
"volume that occurs when fast-forwarding or rewinding through some kinds of "
"audio"
msgstr ""
"<b>启用时</b>，快进或倒回某些类型的音频时，感知音量令人不适的增加会得到抑制"

#: rc_option_editor.cc:3910
msgid "Rewind/Fast-forward buttons change direction immediately"
msgstr "倒回/快进按钮立即改变方向"

#: rc_option_editor.cc:3915
msgid ""
"<b>When enabled</b> rewind/ffwd controls will immediately change playback "
"direction when appropriate.\n"
"\n"
"<b>When disabled</b> rewind/ffwd controls will gradually speed up/slow down "
"playback"
msgstr ""
"<b>启用时</b>，倒回/快进控制会在适当情况下立即改变播放方向。\n"
"\n"
"<b>禁用时</b>，倒回/快进控制会逐渐加快或减慢播放速度"

#: rc_option_editor.cc:3922
msgid "Allow auto-return after rewind/ffwd operations"
msgstr "允许倒回/快进操作后自动返回"

#: rc_option_editor.cc:3927
msgid ""
"<b>When enabled</b> if auto-return is enabled, the playhead will auto-return "
"after rewind/ffwd operations\n"
"\n"
"<b>When disabled</b> the playhead will never auto-return after rewind/ffwd "
"operations"
msgstr ""
"<b>启用时</b>，如果启用了自动返回，播放头将在倒回/快进操作后自动返回。\n"
"\n"
"<b>禁用时</b>，播放头在倒回/快进操作后不会自动返回"

#: rc_option_editor.cc:3935
msgid "Preroll"
msgstr "预滚"

#: rc_option_editor.cc:3940
msgid ""
"The amount of preroll to apply when <b>Play with Preroll</b> or <b>Record "
"with Preroll</b>is initiated.\n"
"\n"
"If <b>Follow Edits</b> is enabled, the preroll is applied to the playhead "
"position when a region is selected or trimmed."
msgstr ""
"启动<b>带预滚播放</b>或<b>带预滚录音</b>时应用的预滚量。\n"
"\n"
"如果启用了<b>跟随编辑</b>，选择或修剪区域时，预滚将应用于播放头位置。"

#: rc_option_editor.cc:3942 trigger_ui.cc:725
msgid "4 Bars"
msgstr "4 小节"

#: rc_option_editor.cc:3943 trigger_ui.cc:727
msgid "2 Bars"
msgstr "2 小节"

#: rc_option_editor.cc:3944 trigger_ui.cc:729
msgid "1 Bar"
msgstr "1 小节"

#: rc_option_editor.cc:3945
msgid "0 (no pre-roll)"
msgstr "0（无预滚）"

#: rc_option_editor.cc:3946
msgid "0.1 second"
msgstr "0.1 秒"

#: rc_option_editor.cc:3947
msgid "0.25 second"
msgstr "0.25 秒"

#: rc_option_editor.cc:3948
msgid "0.5 second"
msgstr "0.5 秒"

#: rc_option_editor.cc:3949
msgid "1.0 second"
msgstr "1.0 秒"

#: rc_option_editor.cc:3950
msgid "2.0 seconds"
msgstr "2.0 秒"

#: rc_option_editor.cc:3955
msgid "Create a marker when a MIDI program change is received (and RECORDING)"
msgstr "收到 MIDI 程序变更时创建标记（录音时）"

#: rc_option_editor.cc:3962
msgid ""
"Locate to the next matching scene marker when a MIDI program change is "
"received (and NOT recording)"
msgstr ""
"收到 MIDI 程序变更且未录音时，定位到下一个匹配的场景标记"

#: rc_option_editor.cc:3970
msgid "Marker Locate Priority"
msgstr "标记定位优先级"

#: rc_option_editor.cc:3976
msgid "Next"
msgstr "下一个"

#: rc_option_editor.cc:3978
msgid "Options for locating to program change/snapshot markers"
msgstr "定位到程序变更/快照标记的选项"

#: rc_option_editor.cc:3981
msgid "Stop transport using the current grid (if any)"
msgstr "使用当前网格（如果有）停止传输"

#: rc_option_editor.cc:3987
msgid "Looping"
msgstr "正在循环"

#: rc_option_editor.cc:3991
msgid "Play loop is a transport mode"
msgstr "播放循环是一种传输模式"

#: rc_option_editor.cc:3996
msgid ""
"<b>When enabled</b> the loop button does not start playback but forces "
"playback to always play the loop\n"
"\n"
"<b>When disabled</b> the loop button starts playing the loop, but stop then "
"cancels loop playback"
msgstr ""
"<b>启用时</b>，循环按钮不会开始播放，而是强制播放始终保持在循环内。\n"
"\n"
"<b>禁用时</b>，循环按钮会开始播放循环，但停止播放会取消循环。"

#: rc_option_editor.cc:4004
msgid "Loop Fades"
msgstr "循环淡化"

#: rc_option_editor.cc:4008
msgid "No fades at loop boundaries"
msgstr "在循环边界处无淡化"

#: rc_option_editor.cc:4009
msgid "Fade out at loop end"
msgstr "在循环结束时淡化"

#: rc_option_editor.cc:4010
msgid "Fade in at loop start & Fade out at loop end"
msgstr "在循环开始时淡入并且在循环结束时淡出"

#: rc_option_editor.cc:4011
msgid "Cross-fade loop end and start"
msgstr "交叉淡化（淡入淡出）循环结束和开始"

#: rc_option_editor.cc:4013
msgid "Options for fades/crossfades at loop boundaries"
msgstr "循环边界处的淡化/交叉淡化（淡入淡出）选项"

#: rc_option_editor.cc:4015
msgid "Dropout (xrun) Handling"
msgstr "掉音（xrun）处理"

#: rc_option_editor.cc:4018
msgid "Stop recording when an xrun occurs"
msgstr "在 xrun（缓存溢出）出现时停止录制"

#: rc_option_editor.cc:4023
msgid ""
"<b>When enabled</b> %1 will stop recording if an over- or underrun is "
"detected by the audio engine"
msgstr ""
"<b>启用时</b> 如果音频引擎检测到一个超载或者欠载运行 %1 将停止录制"

#: rc_option_editor.cc:4029
msgid "Create markers where xruns occur"
msgstr "在 xrun（缓存溢出）出现时创建标记"

#: rc_option_editor.cc:4037
msgid "Reset xrun counter when starting to record"
msgstr "开始录音时重置 xrun 计数器"

#: rc_option_editor.cc:4043 rc_option_editor.cc:4045 rc_option_editor.cc:4053
#: rc_option_editor.cc:4071 rc_option_editor.cc:4073 rc_option_editor.cc:4075
#: rc_option_editor.cc:4092 rc_option_editor.cc:4108 rc_option_editor.cc:4109
msgid "Transport/Chase"
msgstr "传输/追踪"

#: rc_option_editor.cc:4043 rc_option_editor.cc:4165
msgid "MIDI Machine Control (MMC)"
msgstr "MIDI 机器控制"

#: rc_option_editor.cc:4048
msgid "Respond to MMC commands"
msgstr "响应 MMC 命令"

#: rc_option_editor.cc:4056
msgid "Inbound MMC device ID"
msgstr "传入 MMC 设备 ID"

#: rc_option_editor.cc:4064
msgid "MMC Fast-wind behavior"
msgstr "MMC 快速定位行为"

#: rc_option_editor.cc:4068
msgid "Off (MMC fast-forward+rewind are ignored)"
msgstr "关闭（忽略 MMC 快进+倒带）"

#: rc_option_editor.cc:4069 varispeed_dialog.cc:33
msgid "Varispeed"
msgstr "变速"

#: rc_option_editor.cc:4070
msgid "Marker Locate (MMC ffwd/rewd jumps to next/prior marker)"
msgstr "标记定位（MMC 快进/倒带跳转到下一个/上一个标记）"

#: rc_option_editor.cc:4076
msgid "Show Transport Masters Window"
msgstr "显示传输主控窗口"

#: rc_option_editor.cc:4081
msgid "Match session video frame rate to external timecode"
msgstr "匹配会话视频帧率到外部时间码"

#: rc_option_editor.cc:4087
msgid ""
"This option controls the value of the video frame rate <i>while chasing</i> "
"an external timecode source.\n"
"\n"
"<b>When enabled</b> the session video frame rate will be changed to match "
"that of the selected external timecode source.\n"
"\n"
"<b>When disabled</b> the session video frame rate will not be changed to "
"match that of the selected external timecode source.Instead the frame rate "
"indication in the main clock will flash red and %1 will convert between the "
"external timecode standard and the session standard."
msgstr ""
"此选项控制在*追随*外部时间码源时的视频帧率值。\n"
"\n"
"<b>启用时</b>，会话视频帧率将更改为与所选外部时间码源的帧率相匹配。\n"
"\n"
"<b>禁用时</b>，会话视频帧率不会更改为与所选外部时间码源的帧率相匹配。相反，主"
"时钟中的帧率指示将闪烁红光，并且 %1 将在外部时间码标准与会话标准之间进行转换"
"。"

#: rc_option_editor.cc:4096
msgid "BPM Resolution for incoming MIDI Clock"
msgstr "传入 MIDI 时钟的 BPM 分辨率"

#: rc_option_editor.cc:4099
msgid "quarters"
msgstr "四分音符"

#: rc_option_editor.cc:4103
msgid ""
"This option can be used to quantize incoming MIDI clock to whole (or "
"fractions of a) quarter note.\n"
"\n"
"Setting it to zero prevents any quantization, which can result in a rather "
"jittery response to incoming MIDI Clock.\n"
"\n"
"Setting it to 1.0 quantizes to whole (integer) BPM values, and is the "
"default.\n"
"\n"
"If you are using a MIDI clock source that quantizes to some fraction of a "
"quarter note then adjust this setting to reflect that."
msgstr ""
"此选项可用于将传入的 MIDI 时钟量化到整四分音符（或四分音符的分数）。\n"
"\n"
"将其设置为零可防止任何量化，这可能会导致对传入 MIDI 时钟的响应相当不稳定。\n"
"\n"
"将其设置为 1.0 则量化为整数 BPM 值，这也是默认设置。\n"
"\n"
"如果您使用的是将音符量化为四分音符某个分数的 MIDI 时钟源，请调整此设置以进行"
"匹配。"

#: rc_option_editor.cc:4108
msgid "MIDI Clock"
msgstr "MIDI 时钟"

#: rc_option_editor.cc:4111 rc_option_editor.cc:4113 rc_option_editor.cc:4130
#: rc_option_editor.cc:4142 rc_option_editor.cc:4144 rc_option_editor.cc:4146
#: rc_option_editor.cc:4163 rc_option_editor.cc:4165 rc_option_editor.cc:4167
#: rc_option_editor.cc:4175 rc_option_editor.cc:4184 rc_option_editor.cc:4186
msgid "Transport/Generate"
msgstr "传输/生成"

#: rc_option_editor.cc:4111
msgid "Linear Timecode (LTC) Generator"
msgstr "线性时间码生成器"

#: rc_option_editor.cc:4116
msgid "Enable LTC generator"
msgstr "启用 LTC（线性时间码）生成器"

#: rc_option_editor.cc:4123
msgid "Send LTC while stopped"
msgstr "停止时发送 LTC（线性时间码）"

#: rc_option_editor.cc:4129
msgid ""
"<b>When enabled</b> %1 will continue to send LTC information even when the "
"transport (playhead) is not moving"
msgstr ""
"<b>启用时</b>，即使传输（播放指针）未移动，%1 也将继续发送 LTC（线性时间码）"
"信息"

#: rc_option_editor.cc:4132
msgid "LTC generator level [dBFS]"
msgstr "LTC（线性时间码）生成器电平 [dBFS]（分贝振幅）"

#: rc_option_editor.cc:4140
msgid ""
"Specify the Peak Volume of the generated LTC signal in dBFS. A good value "
"is  0dBu ^= -18dBFS in an EBU calibrated system"
msgstr ""
"以 dBFS 为单位指定生成的 LTC 信号的峰值音量。在 EBU 校准系统中，一个较好的值"
"为 0dBu ^= -18dBFS"

#: rc_option_editor.cc:4144
msgid "MIDI Time Code (MTC) Generator"
msgstr "MIDI 时间码生成器"

#: rc_option_editor.cc:4149
msgid "Enable MTC Generator"
msgstr "启用 MIDI 时间码生成器"

#: rc_option_editor.cc:4157
msgid "Max MTC varispeed (%)"
msgstr "最大 MTC 变速（%）"

#: rc_option_editor.cc:4162
msgid "Percentage either side of normal transport speed to transmit MTC."
msgstr "传输 MTC 时相对于正常传输速度的百分比"

#: rc_option_editor.cc:4170
msgid "Send MMC commands"
msgstr "发送 MMC 命令"

#: rc_option_editor.cc:4178
msgid "Outbound MMC device ID"
msgstr "传出 MMC 设备 ID"

#: rc_option_editor.cc:4184
msgid "MIDI Beat Clock (Mclk) Generator"
msgstr "MIDI 拍子计时器（Mclk）生成器"

#: rc_option_editor.cc:4189
msgid "Enable Mclk generator"
msgstr "启用 MIDI 拍子计时器生成器"

#: rc_option_editor.cc:4198
msgid "Silence plugins when the transport is stopped"
msgstr "当播送停止时插件也无声"

#: rc_option_editor.cc:4204
msgid ""
"<b>When enabled</b> plugins will be reset at transport stop. When disabled "
"plugins will be left unchanged at transport stop.\n"
"\n"
"This mostly affects plugins with a \"tail\" like Reverbs."
msgstr ""
"<b>启用时</b>，插件将在传输停止时重置。禁用时，插件在传输停止时将保持不变。\n"
"\n"
"这主要影响具有“尾音”（如混响）的插件。"

#: rc_option_editor.cc:4209
msgid "Scan/Discover"
msgstr "扫描/发现"

#: rc_option_editor.cc:4211 rc_option_editor.cc:4375 rc_option_editor.cc:4520
msgid "Scan for Plugins"
msgstr "扫描插件"

#: rc_option_editor.cc:4223
msgid "Scan for [New] Plugins on Application Start"
msgstr "应用程序启动时扫描[新]插件"

#: rc_option_editor.cc:4229
msgid ""
"<b>When enabled</b> new plugins are searched, tested and added to the cache "
"index on application start. When disabled new plugins will only be available "
"after triggering a 'Scan' manually"
msgstr ""
"<b>启用时</b>，应用程序启动时会搜索、测试新插件并将它们添加到缓存索引中。<b>"
"禁用时</b>，新插件只有在手动触发“扫描”后才可用。"

#: rc_option_editor.cc:4233
msgid "Always Display Plugin Scan Progress"
msgstr "始终显示插件扫描进度"

#: rc_option_editor.cc:4239
msgid ""
"<b>When enabled</b> a popup window showing plugin scan progress is displayed "
"for indexing (cache load) and discovery (detect new plugins)"
msgstr ""
"<b>启用时</b>，将显示一个弹出窗口，展示插件扫描进度，用于索引（缓存加载）和发"
"现（检测新插件）"

#: rc_option_editor.cc:4243
msgid "Verbose Plugin Scan"
msgstr "冗长的插件扫描"

#: rc_option_editor.cc:4249
msgid ""
"<b>When enabled</b> additional information for every plugin is shown to the "
"Plugin Manager Log."
msgstr "<b>启用时</b>，插件管理器日志中将显示每个插件的附加信息。"

#: rc_option_editor.cc:4254
msgid "Open Plugin Manager window when missing plugins are found"
msgstr "找不到插件时打开插件管理器窗口"

#: rc_option_editor.cc:4260
msgid ""
"<b>When enabled</b> the Plugin Manager is display at session load if the "
"session contains any plugins that are missing, or plugins have been updated "
"and require a rescan."
msgstr ""
"<b>启用时</b>，如果会话包含任何丢失的插件，或者插件已更新且需要重新扫描，则会"
"在加载会话时显示插件管理器。"

#: rc_option_editor.cc:4264
msgid "Make new plugins active"
msgstr "启用新插件"

#: rc_option_editor.cc:4270
msgid ""
"<b>When enabled</b> plugins will be activated when they are added to tracks/"
"busses.\n"
"<b>When disabled</b> plugins will be left inactive when they are added to "
"tracks/busses"
msgstr ""
"<b>启用时</b>，插件在被添加到音轨/总线时将被激活。\n"
"<b>禁用时</b>，插件在被添加到音轨/总线时将保持未激活状态。"

#: rc_option_editor.cc:4274
msgid "Setup Sidechain ports when loading plugin with aux inputs"
msgstr "载入插件时使用辅助输入设置侧链端口"

#: rc_option_editor.cc:4280
msgid ""
"<b>When enabled</b> sidechain ports are created for plugins at instantiation "
"time if a plugin has sidechain inputs. Note that the ports themselves will "
"have to be manually connected, so while the plugin pins are connected they "
"are initially fed with silence.\n"
"<b>When disabled</b> sidechain input pins will remain unconnected."
msgstr ""
"<b>启用时</b>，如果插件具有侧链输入，则会在实例化时为该插件创建侧链端口。请注"
"意，端口本身需要手动连接，因此虽然插件引脚已连接，但最初输入的是静音。\n"
"<b>禁用时</b>，侧链输入引脚将保持未连接状态。"

#: rc_option_editor.cc:4282 rc_option_editor.cc:4283 rc_option_editor.cc:4291
#: rc_option_editor.cc:4305 rc_option_editor.cc:4319 rc_option_editor.cc:4323
#: rc_option_editor.cc:4324 rc_option_editor.cc:4338 rc_option_editor.cc:4342
#: rc_option_editor.cc:4344 rc_option_editor.cc:4366
msgid "Plugins/GUI"
msgstr "插件/GUI"

#: rc_option_editor.cc:4282
msgid "Plugin GUI"
msgstr "插件图形用户界面"

#: rc_option_editor.cc:4286
msgid "Automatically open the plugin GUI when adding a new plugin"
msgstr "添加新的插件时自动打开插件图形用户界面"

#: rc_option_editor.cc:4294
msgid ""
"Automatically open instrument plugin GUI when adding a new MIDI Track/Bus"
msgstr ""
"添加新 MIDI 音轨/总线时自动打开乐器插件界面"

#: rc_option_editor.cc:4301
msgid "Show only one plugin window at a time"
msgstr "一次只显示一个插件窗口"

#: rc_option_editor.cc:4307
msgid ""
"<b>When enabled</b> at most one plugin GUI window can be on-screen at a "
"time. <b>When disabled</b>, the number of visible plugin GUI windows is "
"unlimited"
msgstr ""
"<b>启用时</b>，屏幕上一次最多只能显示一个插件 GUI 窗口。<b>禁用时</b>，可见的"
"插件 GUI 窗口数量不受限制"

#: rc_option_editor.cc:4311
msgid "Closing a Plugin GUI Window"
msgstr "关闭插件 GUI 窗口时"

#: rc_option_editor.cc:4315
msgid "only hides the window"
msgstr "仅隐藏窗口"

#: rc_option_editor.cc:4316
msgid "destroys the GUI instance, releasing resources"
msgstr "销毁 GUI 实例，释放资源"

#: rc_option_editor.cc:4317
msgid "only destroys VST2/3 UIs, hides others"
msgstr "仅关闭 VST2/3 UI，隐藏其他窗口"

#: rc_option_editor.cc:4320
msgid ""
"Closing a plugin window, usually only hides it. This makes is fast to open "
"the same plugin UI again at a later time.\n"
"\n"
"Most plugin UIs are inactive and do not consume any CPU resources while they "
"are not mapped on the screen.\n"
"\n"
"However some plugins do consume significant CPU and GPU resources even when "
"they are not currently displayed. This option allows one to work around the "
"issue."
msgstr ""
"关闭插件窗口通常只是将其隐藏，这样以后可以快速再次打开同一个插件界面。\n"
"\n"
"大多数插件界面在未显示于屏幕上时处于非活动状态，不会占用 CPU 资源。\n"
"\n"
"但是，某些插件即使当前未显示也会占用大量 CPU 和 GPU 资源。此选项可用于绕过这一问题。"

#: rc_option_editor.cc:4323
msgid "Mixer Strip Inline Display"
msgstr "混音器声道条内联显示"

#: rc_option_editor.cc:4327
msgid "Show Plugin Inline Display on Mixer Strip by default"
msgstr "默认在混音器声道条中显示插件内联界面"

#: rc_option_editor.cc:4334
msgid ""
"Don't automatically open the plugin GUI when the plugin has an inline "
"display mode"
msgstr ""
"当插件有一个内联显示模式时，不要自动打开插件 GUI（图形用户界面）"

#: rc_option_editor.cc:4342
msgid "VST3 UI"
msgstr "VST3 界面"

#: rc_option_editor.cc:4347
msgid "Automatically show 'Micro Edit' tagged controls on the mixer-strip"
msgstr "在混音器声道条中自动显示标记为“微型编辑”的控件"

#: rc_option_editor.cc:4354
msgid "VST3 Knob Mode"
msgstr "VST3 Knob 模式"

#: rc_option_editor.cc:4359
msgid "Plugin Default"
msgstr "插件 默认"

#: rc_option_editor.cc:4360
msgid "Circular with jump to clicked position (discouraged)"
msgstr "圆形：跳转到单击位置（不建议）"

#: rc_option_editor.cc:4361
msgid "Circular without jump to clicked position"
msgstr "圆形：不跳转到单击位置"

#: rc_option_editor.cc:4362
msgid "Linear: depending on vertical movement"
msgstr "线性：取决于垂直移动"

#: rc_option_editor.cc:4364
msgid ""
"These settings apply to new VST3 plugin instances only.\n"
"Already loaded plugins retain the previous setting."
msgstr ""
"这些设置仅适用于新的 VST3 插件实例。\n"
"已经载入的插件保留之前的设置。"

#: rc_option_editor.cc:4372 rc_option_editor.cc:4374 rc_option_editor.cc:4386
#: rc_option_editor.cc:4398 rc_option_editor.cc:4408 rc_option_editor.cc:4418
#: rc_option_editor.cc:4424 rc_option_editor.cc:4426 rc_option_editor.cc:4431
#: rc_option_editor.cc:4438 rc_option_editor.cc:4448 rc_option_editor.cc:4457
#: rc_option_editor.cc:4467 rc_option_editor.cc:4476 rc_option_editor.cc:4477
#: rc_option_editor.cc:4482 rc_option_editor.cc:4500 rc_option_editor.cc:4503
#: rc_option_editor.cc:4504
msgid "Plugins/VST"
msgstr "插件/VST（虚拟工作室技术）"

#: rc_option_editor.cc:4382
msgid "Enable Mac VST2 support (requires restart or re-scan)"
msgstr "启用 Mac VST2 支持（需要重新启动或重新扫描）"

#: rc_option_editor.cc:4394
msgid "Enable Windows VST2 support (requires restart or re-scan)"
msgstr "启用 Windows VST2 支持（需要重新启动或重新扫描）"

#: rc_option_editor.cc:4404
msgid "Enable Linux VST2 support (requires restart or re-scan)"
msgstr "启用 Linux VST2 支持（需要重新启动或重新扫描）"

#: rc_option_editor.cc:4414
msgid "Enable VST3 support (requires restart or re-scan)"
msgstr "启用 VST3 支持（需要重新启动或重新扫描）"

#: rc_option_editor.cc:4424
msgid "VST 2.x"
msgstr "VST 2.x（虚拟工作室技术）"

#: rc_option_editor.cc:4429
