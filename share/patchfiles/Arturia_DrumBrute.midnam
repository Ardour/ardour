<MIDINameDocument>
  <Author>Holger</Author>
  <MasterDeviceNames>
    <Manufacturer>Arturia</Manufacturer>
    <Model>Drumbrute</Model>
    <CustomDeviceMode Name="Default">
      <ChannelNameSetAssignments>
